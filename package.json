{
  "name": "website-design-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "compile:fixture": "tsx src/cli.ts fixtures/minimal/compiler-input.json artifacts/runtime/minimal",
    "verify:bindings": "tsx src/bindings-cli.ts .skill-bindings/skills-shared.json",
    "project:shared-registry": "tsx src/project-shared-registry.ts",
    "ui:typecheck": "pnpm --filter @website-design-compiler/site typecheck",
    "ui:build": "pnpm --filter @website-design-compiler/site build",
    "browser:typecheck": "tsc --noEmit -p tsconfig.browser.json",
    "browser:qa": "playwright test",
    "browser:receipt": "tsx scripts/browser-qa-receipt.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
