{
  "name": "website-design-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/**/*.test.ts",
    "compile:fixture": "tsx src/cli.ts fixtures/minimal/compiler-input.json artifacts/runtime/minimal",
    "v2:brief-ia": "tsx scripts/v2-brief-ia-fixture.ts",
    "v2:brief-benchmarks": "tsx scripts/v2-brief-benchmark-receipt.ts",
    "v2:content-architecture": "tsx scripts/content-architecture-benchmark-receipt.ts",
    "v2:visual-directions": "tsx scripts/visual-direction-benchmark-receipt.ts",
    "v2:semantic-tokens": "tsx scripts/semantic-token-benchmark-receipt.ts && tsx scripts/semantic-token-projection-receipt.ts",
    "showcase:typecheck": "tsc --noEmit -p tsconfig.showcase.json",
    "showcase:compile": "tsx src/cli.ts fixtures/showcase/compiler-input.json artifacts/showcase/compiler",
    "showcase:compiler-receipt": "tsx scripts/showcase-compiler-receipt.ts",
    "external-skills:receipt": "tsx scripts/external-skill-registry-receipt.ts",
    "media:fixture": "tsx scripts/media-router-fixture.ts",
    "authoring:receipt": "tsx scripts/authoring-fixture-receipt.ts",
    "cms:fixture": "tsx scripts/payload-cms-fixture.ts",
    "verify:bindings": "tsx src/bindings-cli.ts .skill-bindings/skills-shared.json",
    "project:shared-registry": "tsx src/project-shared-registry.ts",
    "provenance:fixture": "tsx src/license-provenance-cli.ts fixtures/provenance/workspace/package.json fixtures/provenance/workspace/pnpm-lock.yaml fixtures/provenance/workspace/rights-evidence.json artifacts/provenance/license-receipt.json",
    "ui:typecheck": "pnpm --filter @website-design-compiler/site typecheck",
    "ui:build": "pnpm --filter @website-design-compiler/site build",
    "storybook:typecheck": "tsc --noEmit -p tsconfig.storybook.json",
    "storybook:build": "pnpm --filter @website-design-compiler/site storybook:build",
    "storybook:qa": "playwright test -c playwright.storybook.config.ts",
    "storybook:receipt": "tsx scripts/storybook-workshop-receipt.ts",
    "browser:typecheck": "tsc --noEmit -p tsconfig.browser.json",
    "browser:qa": "playwright test",
    "browser:receipt": "tsx scripts/browser-qa-receipt.ts",
    "reference:media-fixture": "tsx scripts/reference-media-fixture.ts",
    "reference:browser-fixture": "tsx scripts/reference-browser-fixture.ts",
    "quality:receipt": "tsx scripts/accessibility-performance-receipt.ts",
    "arena:typecheck": "tsc --noEmit -p tsconfig.arena.json",
    "arena:ia-metrics": "tsx scripts/arena-ia-metrics.ts",
    "arena:smoke": "tsx scripts/arena-smoke.ts",
    "release:receipt": "tsx scripts/release-gate-receipt.ts"
  },
  "dependencies": { "@payloadcms/db-sqlite": "3.86.0", "ajv": "^8.17.1", "ajv-formats": "^3.0.1", "payload": "3.86.0", "yaml": "2.9.0" },
  "devDependencies": { "@axe-core/playwright": "4.12.1", "@playwright/test": "^1.59.0", "@types/node": "^24.3.0", "tsx": "^4.20.5", "typescript": "^5.9.2" }
}
