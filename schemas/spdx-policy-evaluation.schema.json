{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/spdx-policy-evaluation.schema.json",
  "title": "SPDX Policy Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","expression","normalizedExpression","astSha256","policyIdentitySha256","identifiers","state","diagnostics","evaluationIdentitySha256"],
  "properties": {
    "schema": { "const": "website-design-compiler/spdx-policy-evaluation/v1" },
    "expression": { "type": "string", "minLength": 1 },
    "normalizedExpression": { "type": "string", "minLength": 1 },
    "astSha256": { "$ref": "#/$defs/sha256" },
    "policyIdentitySha256": { "$ref": "#/$defs/sha256" },
    "identifiers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "state": { "enum": ["ALLOW","REVIEW_REQUIRED","DENY","UNKNOWN"] },
    "diagnostics": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evaluationIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
