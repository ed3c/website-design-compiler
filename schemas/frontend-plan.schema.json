{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/frontend-plan.schema.json",
  "title": "Governed Frontend Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "renderer", "arbitraryMarkupAllowed", "components"],
  "properties": {
    "schema": { "const": "website-design-compiler/frontend-plan/v1" },
    "project": { "type": "string", "minLength": 1 },
    "renderer": { "const": "nextjs-registry" },
    "arbitraryMarkupAllowed": { "const": false },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "component", "props"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "component": { "const": "button" },
              "props": {
                "type": "object",
                "additionalProperties": false,
                "required": ["children"],
                "properties": {
                  "intent": { "enum": ["primary", "secondary"] },
                  "children": { "type": "string", "minLength": 1 },
                  "disabled": { "type": "boolean" }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "component", "props"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "component": { "const": "status-panel" },
              "props": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "title", "message"],
                "properties": {
                  "state": { "enum": ["loading", "empty", "error", "success"] },
                  "title": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "component", "props"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "component": { "const": "rich-section" },
              "props": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "variant", "props", "provenance", "tokenRef"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "kind": {
                    "enum": ["navigation", "hero", "feature-grid", "bento-grid", "proof-cloud", "metrics", "testimonial", "comparison", "pricing", "faq", "cta", "footer", "editorial-prose", "editorial-media", "product-showcase", "media-stage", "graphics-2d-stage", "graphics-3d-stage"]
                  },
                  "variant": { "type": "string", "minLength": 1 },
                  "props": { "type": "object" },
                  "provenance": {
                    "type": "object",
                    "additionalProperties": { "type": "string", "minLength": 1 }
                  },
                  "tokenRef": { "const": "semantic-design-tokens/v2" }
                }
              }
            }
          }
        ]
      }
    }
  }
}
