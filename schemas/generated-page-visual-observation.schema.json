{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/generated-page-visual-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "category", "project", "viewport", "nodeCount", "sectionKinds", "typography", "contrast", "rhythm", "ctaCount", "clippedTextCount"],
  "properties": {
    "schema": { "const": "website-design-compiler/generated-page-visual-observation/v1" },
    "category": { "type": "string", "minLength": 1 },
    "project": { "enum": ["desktop-chromium", "tablet-chromium", "mobile-chromium"] },
    "viewport": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "nodeCount": { "type": "integer", "minimum": 1 },
    "sectionKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "typography": {
      "type": "object", "additionalProperties": false, "required": ["families", "headingToBodyRatio", "distinctHeadingSizes"],
      "properties": {
        "families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "headingToBodyRatio": { "type": "number", "minimum": 0 },
        "distinctHeadingSizes": { "type": "integer", "minimum": 0 }
      }
    },
    "contrast": {
      "type": "object", "additionalProperties": false, "required": ["minimumRatio", "sampleCount"],
      "properties": { "minimumRatio": { "type": "number", "minimum": 0 }, "sampleCount": { "type": "integer", "minimum": 0 } }
    },
    "rhythm": {
      "type": "object", "additionalProperties": false, "required": ["averageVerticalGap", "distinctBackgrounds", "sectionTransitions"],
      "properties": {
        "averageVerticalGap": { "type": "number", "minimum": 0 },
        "distinctBackgrounds": { "type": "integer", "minimum": 0 },
        "sectionTransitions": { "type": "integer", "minimum": 0 }
      }
    },
    "ctaCount": { "type": "integer", "minimum": 0 },
    "clippedTextCount": { "type": "integer", "minimum": 0 }
  }
}
