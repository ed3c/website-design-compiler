{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/release-policy-v2.schema.json",
  "title": "Website Design Compiler release policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profiles", "premiumQuality"],
  "properties": {
    "schema": { "const": "website-design-compiler/release-policy/v2" },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CORE", "NETWORKED_REFERENCE", "ADVANCED_GPU", "COMMERCIAL_PRODUCTION", "FULL_V2"],
      "properties": {
        "CORE": { "$ref": "#/$defs/profile" },
        "NETWORKED_REFERENCE": { "$ref": "#/$defs/profile" },
        "ADVANCED_GPU": { "$ref": "#/$defs/profile" },
        "COMMERCIAL_PRODUCTION": { "$ref": "#/$defs/profile" },
        "FULL_V2": { "$ref": "#/$defs/profile" }
      }
    },
    "premiumQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profilePath"],
      "properties": {
        "profilePath": { "const": "fixtures/v2/release-profiles/premium.json" }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["core", "liveReference", "webgpu", "repositoryRights", "productionProvider", "premiumQuality"] }
        }
      }
    }
  }
}
