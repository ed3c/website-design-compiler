{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/media-orchestration-v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "category", "decisions", "richMediaCount", "gpuCount", "providerBlockedCount", "strategySignature"],
  "properties": {
    "schema": { "const": "website-design-compiler/media-orchestration/v2" }, "category": { "type": "string", "minLength": 1 },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
    "richMediaCount": { "type": "integer", "minimum": 0 }, "gpuCount": { "type": "integer", "minimum": 0 }, "providerBlockedCount": { "type": "integer", "minimum": 0 }, "strategySignature": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["sectionId", "kind", "renderer", "purpose", "justification", "criticality", "lazyPriority", "budget", "accessibility", "fallback", "execution"],
      "properties": {
        "sectionId": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "minLength": 1 }, "renderer": { "enum": ["dom", "image", "video", "pixi", "three"] },
        "purpose": { "type": "string", "minLength": 1 }, "justification": { "type": "string", "minLength": 1 }, "criticality": { "enum": ["primary", "supporting", "decorative"] }, "lazyPriority": { "enum": ["eager", "viewport", "idle"] },
        "budget": { "type": "object", "additionalProperties": false, "required": ["maxBytes", "maxDpr", "maxTriangles", "maxDrawCalls"], "properties": { "maxBytes": { "type": "integer", "minimum": 0 }, "maxDpr": { "type": "number", "exclusiveMinimum": 0 }, "maxTriangles": { "type": "integer", "minimum": 0 }, "maxDrawCalls": { "type": "integer", "minimum": 0 } } },
        "accessibility": { "type": "object", "additionalProperties": false, "required": ["semanticOwner", "altRequired", "descriptionRequired", "canvasAriaHidden"], "properties": { "semanticOwner": { "const": "DOM" }, "altRequired": { "type": "boolean" }, "descriptionRequired": { "type": "boolean" }, "canvasAriaHidden": { "type": "boolean" } } },
        "fallback": { "type": "object", "additionalProperties": false, "required": ["mobile", "gpuFailure", "providerFailure", "reducedMotion"], "properties": { "mobile": { "enum": ["dom", "image", "video", "pixi", "three"] }, "gpuFailure": { "enum": ["dom", "image", "video", "pixi", "three"] }, "providerFailure": { "enum": ["dom", "image", "video", "pixi", "three"] }, "reducedMotion": { "enum": ["dom", "image", "video", "pixi", "three"] } } },
        "execution": { "type": "object", "additionalProperties": false, "required": ["provider", "state", "provenanceRequired"], "properties": { "provider": { "type": "string", "minLength": 1 }, "state": { "enum": ["NO_JOB", "READY_INTERNAL", "PROVIDER_NOT_ADMITTED"] }, "provenanceRequired": { "type": "boolean" } } }
      }
    }
  }
}
