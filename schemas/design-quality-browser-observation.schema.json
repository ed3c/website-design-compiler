{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/design-quality-browser-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "category",
    "project",
    "viewport",
    "git",
    "screenshot",
    "pixels",
    "computed",
    "accessibility"
  ],
  "properties": {
    "schema": {
      "const": "website-design-compiler/design-quality-browser-observation/v1"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "enum": [
        "desktop-chromium",
        "mobile-chromium"
      ]
    },
    "viewport": {
      "enum": [
        "desktop",
        "mobile"
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "ref"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^artifacts/design-quality-browser/screenshots/[^/]+\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pixels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceWidth",
        "sourceHeight",
        "sampledPixels",
        "quantizedUniqueColors",
        "luminanceMean",
        "luminanceStdDev",
        "luminanceSpan",
        "edgeContrastMean",
        "colorEntropy",
        "channels"
      ],
      "properties": {
        "sourceWidth": {
          "type": "integer",
          "minimum": 1
        },
        "sourceHeight": {
          "type": "integer",
          "minimum": 1
        },
        "sampledPixels": {
          "type": "integer",
          "minimum": 1
        },
        "quantizedUniqueColors": {
          "type": "integer",
          "minimum": 1
        },
        "luminanceMean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "luminanceStdDev": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "luminanceSpan": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edgeContrastMean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "colorEntropy": {
          "type": "number",
          "minimum": 0
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "red",
            "green",
            "blue"
          ],
          "properties": {
            "red": {
              "$ref": "#/$defs/channel"
            },
            "green": {
              "$ref": "#/$defs/channel"
            },
            "blue": {
              "$ref": "#/$defs/channel"
            }
          }
        }
      }
    },
    "computed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewport",
        "h1Count",
        "h2Count",
        "h1Px",
        "medianH2Px",
        "fontFamilies",
        "minimumTextContrastRatio",
        "sectionCount",
        "sectionHeights",
        "sectionWidths",
        "renderedColumns",
        "layouts",
        "distinctSectionBackgrounds",
        "spacingGapMean",
        "spacingGapStdDev",
        "pageWidth",
        "pageHeight",
        "overflowX",
        "ctaSectionCount",
        "actionTargets",
        "mediaStages",
        "motionStates",
        "contentBudgetPass",
        "cssTokens"
      ],
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "h1Count": {
          "type": "integer",
          "minimum": 0
        },
        "h2Count": {
          "type": "integer",
          "minimum": 0
        },
        "h1Px": {
          "type": "number",
          "minimum": 0
        },
        "medianH2Px": {
          "type": "number",
          "minimum": 0
        },
        "fontFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimumTextContrastRatio": {
          "type": "number",
          "minimum": 0
        },
        "sectionCount": {
          "type": "integer",
          "minimum": 0
        },
        "sectionHeights": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "sectionWidths": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "renderedColumns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "layouts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "distinctSectionBackgrounds": {
          "type": "integer",
          "minimum": 0
        },
        "spacingGapMean": {
          "type": "number",
          "minimum": 0
        },
        "spacingGapStdDev": {
          "type": "number",
          "minimum": 0
        },
        "pageWidth": {
          "type": "number",
          "minimum": 1
        },
        "pageHeight": {
          "type": "number",
          "minimum": 1
        },
        "overflowX": {
          "type": "boolean"
        },
        "ctaSectionCount": {
          "type": "integer",
          "minimum": 0
        },
        "actionTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "visible"
            ],
            "properties": {
              "width": {
                "type": "number",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "minimum": 0
              },
              "visible": {
                "type": "boolean"
              }
            }
          }
        },
        "mediaStages": {
          "type": "integer",
          "minimum": 0
        },
        "motionStates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contentBudgetPass": {
          "type": "boolean"
        },
        "cssTokens": {
          "type": "object",
          "minProperties": 16,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seriousCriticalViolationCount",
        "ruleIds"
      ],
      "properties": {
        "seriousCriticalViolationCount": {
          "type": "integer",
          "minimum": 0
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "stdDev"
      ],
      "properties": {
        "mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stdDev": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
