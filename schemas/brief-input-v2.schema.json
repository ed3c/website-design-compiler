{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/brief-input/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "briefText"],
  "properties": {
    "schema": { "const": "website-design-compiler/brief-input/v2" },
    "project": { "type": "string", "minLength": 1 },
    "briefText": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["url", "image", "video", "html"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hardConstraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "requestedStages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
