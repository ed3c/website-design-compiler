    "exactHeadBound":{"type":"boolean"},"allEvidenceBound":{"type":"boolean"},"allStructuralPass":{"type":"boolean"},"allOriginalityPass":{"type":"boolean"},"allMeasurementsPass":{"type":"boolean"},
    "premium":{"type":"object","additionalProperties":false,"required":["state","evaluations"],"properties":{"state":{"enum":["PASS","FAIL"]},"evaluations":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/evaluation"}}}}
  },
  "allOf":[{"if":{"type":"object","properties":{"overall":{"const":"PASS"}}},"then":{"type":"object","properties":{"exactHeadBound":{"const":true},"allEvidenceBound":{"const":true},"allStructuralPass":{"const":true},"allOriginalityPass":{"const":true},"allMeasurementsPass":{"const":true},"calibration":{"type":"object","properties":{"state":{"const":"PASS"},"exactObservationSetBound":{"const":true}}},"premium":{"type":"object","properties":{"state":{"const":"PASS"}}}}}}],
