      "properties":{
        "schema":{"const":"website-design-compiler/design-quality-eval/v3"},"category":{"type":"string","minLength":1},"viewport":{"enum":["mobile","desktop"]},"graphSignature":{"type":"string","minLength":1},"threshold":{"type":"number","minimum":78,"maximum":100},"score":{"$ref":"#/$defs/score"},"overall":{"$ref":"#/$defs/state"},"dimensions":{"$ref":"#/$defs/dimensions"},"penalties":{"type":"array","items":{"type":"string","minLength":1}},"originalityAudit":{"$ref":"#/$defs/originalityAudit"},"methods":{"$ref":"#/$defs/methods"},
        "measurement":{"type":"object","additionalProperties":false,"required":["state","observationSchema","screenshotSha256","tokenMatch"],"properties":{"state":{"enum":["PASS","FAIL","ABSENT"]},"observationSchema":{"type":["string","null"]},"screenshotSha256":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"tokenMatch":{"anyOf":[{"$ref":"#/$defs/tokenMatch"},{"type":"null"}]}}},
        "intent":{"type":"object","additionalProperties":false,"required":["mode","requiredConversionSteps","ctaRequired"],"properties":{"mode":{"enum":["CONVERSION","INFORMATION"]},"requiredConversionSteps":{"type":"integer","minimum":0},"ctaRequired":{"type":"boolean"}}}
      }
    },
    "binding":{"type":"object","additionalProperties":false,"required":["schema","category","viewport","pageGraphSha256","designTokensSha256","screenshotSha256","gitSha","graphSignature","screenshotPath"],"properties":{"schema":{"const":"website-design-compiler/design-quality-evidence/v2"},"category":{"type":"string","minLength":1},"viewport":{"enum":["mobile","desktop"]},"pageGraphSha256":{"$ref":"#/$defs/hash"},"designTokensSha256":{"$ref":"#/$defs/hash"},"screenshotSha256":{"$ref":"#/$defs/hash"},"gitSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"graphSignature":{"type":"string","minLength":1},"screenshotPath":{"type":"string","pattern":"^artifacts/design-quality-browser/screenshots/[^/]+\\.png$"}}},
    "decision":{"type":"object","additionalProperties":false,"required":["schema","category","viewport","threshold","structuralScore","structuralState","evidenceState","overall","bindings","reasons"],"properties":{"schema":{"const":"website-design-compiler/premium-quality-decision/v2"},"category":{"type":"string","minLength":1},"viewport":{"enum":["mobile","desktop"]},"threshold":{"type":"number","minimum":78,"maximum":100},"structuralScore":{"$ref":"#/$defs/score"},"structuralState":{"$ref":"#/$defs/state"},"evidenceState":{"$ref":"#/$defs/state"},"overall":{"enum":["PREMIUM_PASS","FAIL"]},"bindings":{"type":"object","additionalProperties":false,"required":["pageGraph","designTokens","screenshot","gitSha","graphSignature"],"properties":{"pageGraph":{"$ref":"#/$defs/bindingState"},"designTokens":{"$ref":"#/$defs/bindingState"},"screenshot":{"$ref":"#/$defs/bindingState"},"gitSha":{"$ref":"#/$defs/bindingState"},"graphSignature":{"$ref":"#/$defs/bindingState"}}},"reasons":{"type":"array","items":{"type":"string","minLength":1}}}},
    "source":{"type":"object","additionalProperties":false,"required":["generatedPageReceipt","generatedPageReceiptGitSha","qualityObservationPath","qualityObservationSha256","productionProjection","productionProjectionPath","productionProjectionSha256","semanticTokensSourceSha256","structuralOriginalityCorpus","visualOriginalityCorpus"],"properties":{"generatedPageReceipt":{"const":"website-design-compiler/generated-page-browser-receipt/v3"},"generatedPageReceiptGitSha":{"type":"string","minLength":1},"qualityObservationPath":{"type":"string","minLength":1},"qualityObservationSha256":{"$ref":"#/$defs/hash"},"productionProjection":{"const":"website-design-compiler/site-page-graph-projection/v2"},"productionProjectionPath":{"const":"apps/site/generated/benchmark-page-graphs.json"},"productionProjectionSha256":{"$ref":"#/$defs/hash"},"semanticTokensSourceSha256":{"$ref":"#/$defs/hash"},"structuralOriginalityCorpus":{"type":"array","minItems":5,"items":{"type":"string","minLength":1}},"visualOriginalityCorpus":{"type":"array","minItems":5,"items":{"type":"string","minLength":1}}}},
    "evaluation":{"type":"object","additionalProperties":false,"required":["card","binding","decision","source"],"properties":{"card":{"$ref":"#/$defs/card"},"binding":{"$ref":"#/$defs/binding"},"decision":{"$ref":"#/$defs/decision"},"source":{"$ref":"#/$defs/source"}}}
