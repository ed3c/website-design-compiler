      "properties":{
        "schema":{"const":"website-design-compiler/design-quality-release-profile/v3"},"id":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/hash"},"premiumQualityThreshold":{"type":"number","minimum":78,"maximum":100},"originalitySimilarityThreshold":{"type":"number","minimum":0.82,"maximum":1},"requiredViewports":{"const":["mobile","desktop"]},"requireExactEvidenceBinding":{"const":true},"evaluator":{"type":"object","additionalProperties":false,"required":["schema","scoreModel","structuralSimilarity","visualSimilarity"],"properties":{"schema":{"const":"website-design-compiler/design-quality-evaluator-config/v3"},"scoreModel":{"const":"runtime-evidence-weighted/v3"},"structuralSimilarity":{"const":"ordered-page-graph/v1"},"visualSimilarity":{"const":"calibrated-visual/v1"}}},
        "calibrationReceipt":{"type":"object","additionalProperties":false,"required":["path","schema"],"properties":{"path":{"const":"artifacts/v3/design-quality-calibration/design-quality-calibration-receipt.json"},"schema":{"const":"website-design-compiler/design-quality-calibration-receipt/v2"}}}
      }
    },
    "calibration":{"type":"object","additionalProperties":false,"required":["state","path","schema","sha256","exactObservationSetBound"],"properties":{"state":{"$ref":"#/$defs/state"},"path":{"const":"artifacts/v3/design-quality-calibration/design-quality-calibration-receipt.json"},"schema":{"const":"website-design-compiler/design-quality-calibration-receipt/v2"},"sha256":{"$ref":"#/$defs/hash"},"exactObservationSetBound":{"type":"boolean"}}},
    "dimensions":{"type":"object","additionalProperties":false,"required":["hierarchy","typography","composition","rhythm","sectionTransitions","density","contrast","ctaClarity","responsiveCoherence","mediaRestraint","motionRestraint","differentiation","originality"],"properties":{"hierarchy":{"$ref":"#/$defs/score"},"typography":{"$ref":"#/$defs/score"},"composition":{"$ref":"#/$defs/score"},"rhythm":{"$ref":"#/$defs/score"},"sectionTransitions":{"$ref":"#/$defs/score"},"density":{"$ref":"#/$defs/score"},"contrast":{"$ref":"#/$defs/score"},"ctaClarity":{"$ref":"#/$defs/score"},"responsiveCoherence":{"$ref":"#/$defs/score"},"mediaRestraint":{"$ref":"#/$defs/score"},"motionRestraint":{"$ref":"#/$defs/score"},"differentiation":{"$ref":"#/$defs/score"},"originality":{"$ref":"#/$defs/score"}}},
    "tokenMatch":{"type":"object","additionalProperties":false,"required":["state","matched","total","mismatches"],"properties":{"state":{"$ref":"#/$defs/state"},"matched":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":1},"mismatches":{"type":"array","items":{"type":"string","minLength":1}}}},
    "originalityAudit":{"type":"object","additionalProperties":false,"required":["state","threshold","maxReferenceSimilarity","maxCorpusSimilarity","nearestReference","nearestCorpus","maxVisualReferenceSimilarity","maxVisualCorpusSimilarity","nearestVisualReference","nearestVisualCorpus","reasons"],"properties":{"state":{"$ref":"#/$defs/state"},"threshold":{"type":"number","minimum":0.82,"maximum":1},"maxReferenceSimilarity":{"type":"number","minimum":0,"maximum":1},"maxCorpusSimilarity":{"type":"number","minimum":0,"maximum":1},"nearestReference":{"type":["string","null"]},"nearestCorpus":{"type":["string","null"]},"maxVisualReferenceSimilarity":{"type":"number","minimum":0,"maximum":1},"maxVisualCorpusSimilarity":{"type":"number","minimum":0,"maximum":1},"nearestVisualReference":{"type":["string","null"]},"nearestVisualCorpus":{"type":["string","null"]},"reasons":{"type":"array","items":{"type":"string","minLength":1}}}},
    "card":{
