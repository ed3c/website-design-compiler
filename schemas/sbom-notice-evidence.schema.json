{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/sbom-notice-evidence.schema.json",
  "title": "SBOM and Notice Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","format","buildSubjectSha256","repositoryTree","lockfileSha256","productionGraphSha256","components","noticeSubjects","blockingDiagnostics","overall","generatedAt","evidenceIdentitySha256"],
  "properties": {
    "schema": { "const": "website-design-compiler/sbom-notice-evidence/v1" },
    "format": { "const": "website-design-compiler/sbom-lite/v1" },
    "buildSubjectSha256": { "$ref": "#/$defs/sha256" },
    "repositoryTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "lockfileSha256": { "$ref": "#/$defs/sha256" },
    "productionGraphSha256": { "$ref": "#/$defs/sha256" },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "noticeSubjects": { "type": "array", "items": { "$ref": "#/$defs/noticeSubject" } },
    "blockingDiagnostics": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "overall": { "enum": ["PASS","FAIL"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evidenceIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ] },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","version","artifactSha256","distributed","metadataState","metadataDiagnostic","licenseExpression","licenseTextSha256","attributionRequired","noticeTextSha256","admissionIdentitySha256","bomRef","evidenceState"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "distributed": { "type": "boolean" },
        "metadataState": { "enum": ["COMPLETE","MISSING","READ_ERROR","PARSE_ERROR"] },
        "metadataDiagnostic": { "type": ["string","null"], "minLength": 1 },
        "licenseExpression": { "type": ["string","null"], "minLength": 1 },
        "licenseTextSha256": { "$ref": "#/$defs/nullableSha256" },
        "attributionRequired": { "type": "boolean" },
        "noticeTextSha256": { "$ref": "#/$defs/nullableSha256" },
        "admissionIdentitySha256": { "$ref": "#/$defs/nullableSha256" },
        "bomRef": { "type": "string", "minLength": 1 },
        "evidenceState": { "enum": ["COMPLETE","INCOMPLETE","NOT_DISTRIBUTED"] }
      }
    },
    "noticeSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bomRef","name","version","artifactSha256","noticeTextSha256","admissionIdentitySha256"],
      "properties": {
        "bomRef": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "noticeTextSha256": { "$ref": "#/$defs/sha256" },
        "admissionIdentitySha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
