{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/projection-export-bundle.schema.json",
  "title": "Projection Export Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","bundleId","templateVersion","allowedAccessClassifications","sourceSetSha256","recordCount","records","outputs","generatedAt","bundleIdentitySha256"],
  "properties": {
    "schema": { "const": "website-design-compiler/projection-export-bundle/v1" },
    "bundleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "templateVersion": { "type": "string", "minLength": 1 },
    "allowedAccessClassifications": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/access" } },
    "sourceSetSha256": { "$ref": "#/$defs/sha256" },
    "recordCount": { "type": "integer", "minimum": 1 },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdown","csv","json"],
      "properties": {
        "markdown": { "$ref": "#/$defs/output" },
        "csv": { "$ref": "#/$defs/output" },
        "json": { "$ref": "#/$defs/output" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "bundleIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "access": { "enum": ["PUBLIC","INTERNAL","PRIVATE","PROTECTED"] },
    "scalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","kind","title","sourceUri","sourceSha256","accessClassification","fields"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
        "kind": { "enum": ["ARCHITECTURE","DECISION","PROMPT","SOURCE","TECHNOLOGY","ISSUE","PULL_REQUEST","EVIDENCE","HANDOFF","OTHER"] },
        "title": { "type": "string", "minLength": 1 },
        "sourceUri": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "accessClassification": { "$ref": "#/$defs/access" },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType","content","contentSha256"],
      "properties": {
        "mediaType": { "enum": ["text/markdown","text/csv","application/json"] },
        "content": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
