{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/graphics-3d-plan/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine", "rendererPolicy", "webgpuAdapter", "scene", "camera", "lights", "materials", "interaction", "lod", "dprPolicy", "fallback", "lifecycle", "assetBudget", "proceduralAdapter", "experimental"],
  "properties": {
    "schema": { "const": "website-design-compiler/graphics-3d-plan/v2" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "three", "reactThreeFiber"],
      "properties": {
        "renderer": { "const": "webgl" },
        "three": { "const": "0.184.0" },
        "reactThreeFiber": { "const": "9.6.1" }
      }
    },
    "rendererPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableDefault", "webgpuOptInFallbackOrder", "receiptStates"],
      "properties": {
        "stableDefault": { "const": "webgl" },
        "webgpuOptInFallbackOrder": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [{ "const": "webgpu" }, { "const": "webgl" }, { "const": "static" }],
          "items": false
        },
        "receiptStates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "WEBGPU_PASS" },
            { "const": "WEBGL_FALLBACK" },
            { "const": "STATIC_FALLBACK" }
          ],
          "items": false
        }
      }
    },
    "webgpuAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "renderer", "rendererVersion", "tslModule", "requiredFeatures", "capabilityIdentity"],
      "properties": {
        "adapter": { "const": "navigator.gpu" },
        "renderer": { "const": "three.WebGPURenderer" },
        "rendererVersion": { "const": "0.184.0" },
        "tslModule": { "const": "three/tsl@0.184.0" },
        "requiredFeatures": { "type": "array", "maxItems": 0 },
        "capabilityIdentity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": "adapter-info" },
            { "const": "features" },
            { "const": "limits" }
          ],
          "items": false
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "criticalContent", "frameloop"],
      "properties": {
        "id": { "const": "procedural-proof" },
        "purpose": { "const": "illustration" },
        "criticalContent": { "const": false },
        "frameloop": { "const": "demand" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "position", "fov", "near", "far"],
      "properties": {
        "type": { "const": "perspective" },
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "fov": { "type": "number", "minimum": 20, "maximum": 75 },
        "near": { "type": "number", "exclusiveMinimum": 0 },
        "far": { "type": "number", "minimum": 10, "maximum": 1000 }
      }
    },
    "lights": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "intensity"],
        "properties": {
          "type": { "enum": ["ambient", "directional", "hemisphere"] },
          "intensity": { "type": "number", "minimum": 0, "maximum": 5 }
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "webgpu", "webglFallback", "staticFallback", "criticalContent", "maxMaterials"],
      "properties": {
        "policy": { "const": "tsl-node-material" },
        "webgpu": { "const": "MeshStandardNodeMaterial" },
        "webglFallback": { "const": "MeshStandardMaterial" },
        "staticFallback": { "const": "DOM-owned-poster" },
        "criticalContent": { "const": false },
        "maxMaterials": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointerRequired", "primaryActionDependency"],
      "properties": {
        "pointerRequired": { "const": false },
        "primaryActionDependency": { "const": false }
      }
    },
    "lod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "mobileSimplification"],
      "properties": {
        "policy": { "const": "procedural-complexity-cap" },
        "mobileSimplification": { "const": true }
      }
    },
    "dprPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktopMax", "coarsePointerMax"],
      "properties": {
        "desktopMax": { "const": 1.75 },
        "coarsePointerMax": { "const": 1.25 }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticDom", "staticPoster", "failedWebglHook", "webgpuOptInHook"],
      "properties": {
        "semanticDom": { "const": "REQUIRED" },
        "staticPoster": { "const": "REQUIRED" },
        "failedWebglHook": { "const": "graphics3d=off" },
        "webgpuOptInHook": { "const": "graphics3d=webgpu" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lazyChunk", "lazyWebgpuImport", "frameloopDemand", "continuousFrameLoop", "deviceLossFallback", "disposeGeneratedGeometry", "disposeGeneratedMaterial", "disposeRendererAndDevice"],
      "properties": {
        "lazyChunk": { "const": true },
        "lazyWebgpuImport": { "const": true },
        "frameloopDemand": { "const": true },
        "continuousFrameLoop": { "const": false },
        "deviceLossFallback": { "const": true },
        "disposeGeneratedGeometry": { "const": true },
        "disposeGeneratedMaterial": { "const": true },
        "disposeRendererAndDevice": { "const": true }
      }
    },
    "assetBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalBytes", "textureBytes", "maxTextureMemoryBytes", "maxTriangles", "maxDrawCalls", "maxFramesPerInvalidation"],
      "properties": {
        "externalBytes": { "const": 0 },
        "textureBytes": { "const": 0 },
        "maxTextureMemoryBytes": { "const": 16777216 },
        "maxTriangles": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "maxDrawCalls": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxFramesPerInvalidation": { "const": 1 }
      }
    },
    "proceduralAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceRepository", "sourceCommit", "sourceLicense", "factoryContract", "semantics", "provenanceRequired"],
      "properties": {
        "name": { "const": "img2threejs" },
        "sourceRepository": { "const": "img2threejs/img2threejs" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceLicense": { "const": "Apache-2.0" },
        "factoryContract": { "const": "THREE.Group" },
        "semantics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [{ "const": "pivots" }, { "const": "sockets" }, { "const": "colliders" }],
          "items": false
        },
        "provenanceRequired": { "const": true }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webgpuTsl"],
      "properties": {
        "webgpuTsl": { "const": "NOT_EXERCISED" }
      }
    }
  }
}
