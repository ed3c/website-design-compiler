{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/design-quality-eval-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overall", "git", "releaseProfile", "categoryCount", "viewportCoverage", "exactHeadBound", "allEvidenceBound", "allStructuralPass", "allOriginalityPass", "allMeasurementsPass", "premium"],
  "properties": {
    "schema": { "const": "website-design-compiler/design-quality-eval-receipt/v2" },
    "overall": { "enum": ["PASS", "FAIL"] },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "ref"],
      "properties": { "sha": { "type": "string" }, "ref": { "type": "string" } }
    },
    "releaseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "sha256", "premiumQualityThreshold", "originalitySimilarityThreshold", "requiredViewports", "requireExactEvidenceBinding"],
      "properties": {
        "schema": { "type": "string" },
        "id": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "premiumQualityThreshold": { "type": "number" },
        "originalitySimilarityThreshold": { "type": "number" },
        "requiredViewports": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requireExactEvidenceBinding": { "type": "boolean" }
      }
    },
    "categoryCount": { "const": 6 },
    "viewportCoverage": { "type": "object", "additionalProperties": false, "required": ["mobile", "desktop"], "properties": { "mobile": { "const": 6 }, "desktop": { "const": 6 } } },
    "exactHeadBound": { "type": "boolean" },
    "allEvidenceBound": { "type": "boolean" },
    "allStructuralPass": { "type": "boolean" },
    "allOriginalityPass": { "type": "boolean" },
    "allMeasurementsPass": { "type": "boolean" },
    "premium": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evaluations"],
      "properties": {
        "state": { "enum": ["PASS", "FAIL"] },
        "evaluations": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/evaluation" } }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "state": { "enum": ["PASS", "FAIL"] },
    "bindingState": { "enum": ["BOUND", "ABSENT", "MISMATCH"] },
    "dimensions": { "type": "object", "additionalProperties": false, "required": ["hierarchy", "composition", "rhythm", "density", "ctaClarity", "responsiveCoherence", "mediaRestraint", "motionRestraint", "differentiation", "originality"], "properties": { "hierarchy": { "$ref": "#/$defs/score" }, "composition": { "$ref": "#/$defs/score" }, "rhythm": { "$ref": "#/$defs/score" }, "density": { "$ref": "#/$defs/score" }, "ctaClarity": { "$ref": "#/$defs/score" }, "responsiveCoherence": { "$ref": "#/$defs/score" }, "mediaRestraint": { "$ref": "#/$defs/score" }, "motionRestraint": { "$ref": "#/$defs/score" }, "differentiation": { "$ref": "#/$defs/score" }, "originality": { "$ref": "#/$defs/score" } } },
    "tokenMatch": { "type": "object", "additionalProperties": false, "required": ["state", "matched", "total", "mismatches"], "properties": { "state": { "$ref": "#/$defs/state" }, "matched": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 }, "mismatches": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "originalityAudit": { "type": "object", "additionalProperties": false, "required": ["state", "threshold", "maxReferenceSimilarity", "maxCorpusSimilarity", "nearestReference", "nearestCorpus", "maxVisualReferenceSimilarity", "maxVisualCorpusSimilarity", "nearestVisualReference", "nearestVisualCorpus", "reasons"], "properties": { "state": { "$ref": "#/$defs/state" }, "threshold": { "type": "number", "minimum": 0, "maximum": 1 }, "maxReferenceSimilarity": { "type": "number", "minimum": 0, "maximum": 1 }, "maxCorpusSimilarity": { "type": "number", "minimum": 0, "maximum": 1 }, "nearestReference": { "type": ["string", "null"] }, "nearestCorpus": { "type": ["string", "null"] }, "maxVisualReferenceSimilarity": { "type": "number", "minimum": 0, "maximum": 1 }, "maxVisualCorpusSimilarity": { "type": "number", "minimum": 0, "maximum": 1 }, "nearestVisualReference": { "type": ["string", "null"] }, "nearestVisualCorpus": { "type": ["string", "null"] }, "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "card": { "type": "object", "additionalProperties": false, "required": ["schema", "category", "viewport", "graphSignature", "threshold", "score", "overall", "dimensions", "penalties", "originalityAudit", "measurement", "intent"], "properties": { "schema": { "const": "website-design-compiler/design-quality-eval/v2" }, "category": { "type": "string", "minLength": 1 }, "viewport": { "enum": ["mobile", "desktop"] }, "graphSignature": { "type": "string", "minLength": 1 }, "threshold": { "$ref": "#/$defs/score" }, "score": { "$ref": "#/$defs/score" }, "overall": { "$ref": "#/$defs/state" }, "dimensions": { "$ref": "#/$defs/dimensions" }, "penalties": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "originalityAudit": { "$ref": "#/$defs/originalityAudit" }, "measurement": { "type": "object", "additionalProperties": false, "required": ["state", "observationSchema", "screenshotSha256", "tokenMatch"], "properties": { "state": { "enum": ["PASS", "FAIL", "ABSENT"] }, "observationSchema": { "type": ["string", "null"] }, "screenshotSha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }, "tokenMatch": { "anyOf": [{ "$ref": "#/$defs/tokenMatch" }, { "type": "null" }] } } }, "intent": { "type": "object", "additionalProperties": false, "required": ["mode", "requiredConversionSteps", "ctaRequired"], "properties": { "mode": { "enum": ["CONVERSION", "INFORMATION"] }, "requiredConversionSteps": { "type": "integer", "minimum": 0 }, "ctaRequired": { "type": "boolean" } } } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["schema", "category", "viewport", "pageGraphSha256", "designTokensSha256", "screenshotSha256", "gitSha", "graphSignature", "screenshotPath"], "properties": { "schema": { "const": "website-design-compiler/design-quality-evidence/v2" }, "category": { "type": "string", "minLength": 1 }, "viewport": { "enum": ["mobile", "desktop"] }, "pageGraphSha256": { "$ref": "#/$defs/hash" }, "designTokensSha256": { "$ref": "#/$defs/hash" }, "screenshotSha256": { "$ref": "#/$defs/hash" }, "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "graphSignature": { "type": "string", "minLength": 1 }, "screenshotPath": { "type": "string", "pattern": "^artifacts/design-quality-browser/screenshots/[^/]+\\.png$" } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["schema", "category", "viewport", "threshold", "structuralScore", "structuralState", "evidenceState", "overall", "bindings", "reasons"], "properties": { "schema": { "const": "website-design-compiler/premium-quality-decision/v2" }, "category": { "type": "string", "minLength": 1 }, "viewport": { "enum": ["mobile", "desktop"] }, "threshold": { "$ref": "#/$defs/score" }, "structuralScore": { "$ref": "#/$defs/score" }, "structuralState": { "$ref": "#/$defs/state" }, "evidenceState": { "$ref": "#/$defs/state" }, "overall": { "enum": ["PREMIUM_PASS", "FAIL"] }, "bindings": { "type": "object", "additionalProperties": false, "required": ["pageGraph", "designTokens", "screenshot", "gitSha", "graphSignature"], "properties": { "pageGraph": { "$ref": "#/$defs/bindingState" }, "designTokens": { "$ref": "#/$defs/bindingState" }, "screenshot": { "$ref": "#/$defs/bindingState" }, "gitSha": { "$ref": "#/$defs/bindingState" }, "graphSignature": { "$ref": "#/$defs/bindingState" } } }, "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["generatedPageReceipt", "generatedPageReceiptGitSha", "qualityObservationPath", "qualityObservationSha256", "productionProjection", "productionProjectionPath", "productionProjectionSha256", "semanticTokensSourceSha256", "structuralOriginalityCorpus", "visualOriginalityCorpus"], "properties": { "generatedPageReceipt": { "const": "website-design-compiler/generated-page-browser-receipt/v3" }, "generatedPageReceiptGitSha": { "type": "string", "minLength": 1 }, "qualityObservationPath": { "type": "string", "minLength": 1 }, "qualityObservationSha256": { "$ref": "#/$defs/hash" }, "productionProjection": { "const": "website-design-compiler/site-page-graph-projection/v2" }, "productionProjectionPath": { "const": "apps/site/generated/benchmark-page-graphs.json" }, "productionProjectionSha256": { "$ref": "#/$defs/hash" }, "semanticTokensSourceSha256": { "$ref": "#/$defs/hash" }, "structuralOriginalityCorpus": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } }, "visualOriginalityCorpus": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } } } },
    "evaluation": { "type": "object", "additionalProperties": false, "required": ["card", "binding", "decision", "source"], "properties": { "card": { "$ref": "#/$defs/card" }, "binding": { "$ref": "#/$defs/binding" }, "decision": { "$ref": "#/$defs/decision" }, "source": { "$ref": "#/$defs/source" } } }
  }
}
