{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/storybook-visual-review/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceFilesSha256", "reviewer", "screenshots"],
  "properties": {
    "schema": { "const": "website-design-compiler/storybook-visual-review/v1" },
    "sourceFilesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["agent", "human"] },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "verdict", "observations"],
        "properties": {
          "name": { "type": "string", "pattern": "\\.png$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "verdict": { "enum": ["PASS", "FAIL"] },
          "observations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
