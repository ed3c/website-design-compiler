{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/zero-context-handoff.schema.json",
  "title": "Zero Context Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","fromTaskId","toTaskId","dependencyCompletionIdentitySha256","nextTaskIdentitySha256","nextSubjectSha","allowedWriteset","excludedPaths","requiredArtifacts","negativeControls","predecessorArtifacts","packetIdentitySha256"],
  "properties": {
    "schema": { "const": "website-design-compiler/zero-context-handoff/v1" },
    "fromTaskId": { "type": "string", "minLength": 3 },
    "toTaskId": { "type": "string", "minLength": 3 },
    "dependencyCompletionIdentitySha256": { "$ref": "#/$defs/sha256" },
    "nextTaskIdentitySha256": { "$ref": "#/$defs/sha256" },
    "nextSubjectSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "allowedWriteset": { "$ref": "#/$defs/pathList" },
    "excludedPaths": { "$ref": "#/$defs/pathList" },
    "requiredArtifacts": { "$ref": "#/$defs/pathList" },
    "negativeControls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "predecessorArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "packetIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pathList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path","sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
