{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/production-rights-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subjects"],
  "properties": {
    "schema": { "const": "website-design-compiler/production-rights-evidence/v1" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "versionOrIdentity", "licenseExpression", "evidence", "attributionRequired", "distributed", "geographicRestrictions", "usageRestrictions"],
        "properties": {
          "id": { "type": "string", "pattern": "^(model|generated-output|service):[A-Za-z0-9._:@/+,-]+$" },
          "kind": { "enum": ["model", "generated-output", "service"] },
          "name": { "type": "string", "minLength": 1 },
          "versionOrIdentity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+,-]{0,511}$" },
          "licenseExpression": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "sha256", "verifiedAt"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://[^\\s/?#]+(?:/[^\\s?#]*)?$" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "verifiedAt": { "type": "string", "format": "date-time" }
              }
            }
          },
          "attributionRequired": { "type": "boolean" },
          "distributed": { "type": "boolean" },
          "geographicRestrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "usageRestrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
