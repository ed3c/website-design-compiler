{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/responsive-page-graph-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "category", "semanticOrder", "mobile", "tablet", "desktop"],
  "properties": {
    "schema": { "const": "website-design-compiler/responsive-page-graph/v2" },
    "category": { "type": "string", "minLength": 1 },
    "semanticOrder": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "mobile": { "$ref": "#/$defs/projection" },
    "tablet": { "$ref": "#/$defs/projection" },
    "desktop": { "$ref": "#/$defs/projection" }
  },
  "$defs": {
    "projection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "composition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "composition": { "$ref": "#/$defs/composition" }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "columns", "visualOrder", "mediaPlacement", "sticky", "density", "maxContentChars"],
      "properties": {
        "layout": { "enum": ["stack", "split", "grid", "inline", "stage", "list"] },
        "columns": { "type": "integer", "minimum": 1, "maximum": 4 },
        "visualOrder": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["content", "media"] } },
        "mediaPlacement": { "enum": ["before", "after", "background", "none"] },
        "sticky": { "type": "boolean" },
        "density": { "enum": ["compact", "comfortable", "spacious"] },
        "maxContentChars": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
