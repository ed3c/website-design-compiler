{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/production-content-patch.schema.json",
  "title": "Production Content Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "patchId", "expectedBaseDigest", "actor", "evidenceSha256", "operations", "patchIdentitySha256"],
  "properties": {
    "schema": { "const": "website-design-compiler/production-content-patch/v1" },
    "patchId": { "$ref": "#/$defs/stableId" },
    "expectedBaseDigest": { "$ref": "#/$defs/sha256" },
    "actor": { "$ref": "#/$defs/actor" },
    "evidenceSha256": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } },
    "patchIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "nodeKind": { "enum": ["navigation", "hero", "feature-grid", "bento-grid", "proof-cloud", "metrics", "testimonial", "comparison", "pricing", "faq", "cta", "footer", "editorial-prose", "editorial-media", "product-showcase", "media-stage", "graphics-2d-stage", "graphics-3d-stage"] },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["HUMAN", "AGENT"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "contentValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "op", "nodeId", "expectedNodeKind", "field", "slot", "expectedContentFieldSha256", "value", "sourceType", "sourceObservationSha256"],
      "properties": {
        "operationId": { "$ref": "#/$defs/stableId" },
        "op": { "const": "SET_CONTENT_SLOT" },
        "nodeId": { "type": "string", "minLength": 1 },
        "expectedNodeKind": { "$ref": "#/$defs/nodeKind" },
        "field": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
        "slot": { "$ref": "#/$defs/stableId" },
        "expectedContentFieldSha256": { "$ref": "#/$defs/sha256" },
        "value": { "$ref": "#/$defs/contentValue" },
        "sourceType": { "enum": ["observed_fact", "user_supplied_claim"] },
        "sourceObservationSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
