{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/reference-manifest.schema.json",
  "title": "Reference Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "entries"],
  "properties": {
    "schema": { "const": "website-design-compiler/reference-manifest/v1" },
    "project": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "captureState", "observableFacts", "unknownImplementationDetails", "provenance"],
        "properties": {
          "id": { "type": "string", "pattern": "^ref-[0-9]{3,}$" },
          "kind": { "enum": ["url", "image", "video", "html"] },
          "source": { "type": "string", "minLength": 1 },
          "captureState": { "enum": ["PASS", "FAIL", "ABSENT", "NOT_IMPLEMENTED", "NOT_EXERCISED", "SKIPPED_BY_POLICY"] },
          "observableFacts": { "type": "array", "items": { "type": "string" } },
          "unknownImplementationDetails": { "const": true },
          "reason": { "type": "string" },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "sourceKind", "sourceMode"],
            "properties": {
              "adapter": { "type": "string", "minLength": 1 },
              "sourceKind": { "enum": ["url", "image", "video", "html"] },
              "sourceMode": { "enum": ["INLINE", "FILE", "REMOTE", "UNEXERCISED"] },
              "requestedUrl": { "type": "string", "format": "uri" },
              "finalUrl": { "type": "string", "format": "uri" },
              "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
              "contentType": { "type": "string", "minLength": 1 },
              "responseBytes": { "type": "integer", "minimum": 0 },
              "responseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "artifactIdentity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "capturedAt": { "type": "string", "format": "date-time" },
              "dnsResolutions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["attempt", "hostname", "addresses", "observedAt"],
                  "properties": {
                    "attempt": { "type": "integer", "minimum": 1 },
                    "hostname": { "type": "string", "minLength": 1 },
                    "addresses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "observedAt": { "type": "string", "format": "date-time" }
                  }
                }
              },
              "redirectChain": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["attempt", "fromUrl", "status", "toUrl"],
                  "properties": {
                    "attempt": { "type": "integer", "minimum": 1 },
                    "fromUrl": { "type": "string", "format": "uri" },
                    "status": { "type": "integer", "minimum": 300, "maximum": 399 },
                    "toUrl": { "type": "string", "format": "uri" }
                  }
                }
              },
              "attemptCount": { "type": "integer", "minimum": 1 },
              "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
              "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
              "startedAt": { "type": "string", "format": "date-time" },
              "completedAt": { "type": "string", "format": "date-time" },
              "transportMode": { "enum": ["PINNED_NETWORK", "INJECTED_TEST"] },
              "connectedAddress": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
