{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/live-reference-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overall", "executionMode", "transportMode", "approval", "policy", "targets", "promotionBlockedReason", "git"],
  "properties": {
    "schema": { "const": "website-design-compiler/live-reference-receipt/v2" },
    "overall": { "enum": ["PASS", "FAIL", "NOT_EXERCISED"] },
    "executionMode": { "const": "LIVE" },
    "transportMode": { "enum": ["PRODUCTION", "INJECTED"] },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "approvedAt", "targetCount"],
      "properties": { "id": { "type": "string" }, "approvedAt": { "type": "string", "format": "date-time" }, "targetCount": { "type": "integer", "minimum": 2 } }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["httpsOnly", "credentialsForbidden", "queryForbidden", "maxRedirects", "maxBytes", "timeoutMs", "maxAttempts", "retryBackoffMs"],
      "properties": {
        "httpsOnly": { "const": true }, "credentialsForbidden": { "const": true }, "queryForbidden": { "const": true },
        "maxRedirects": { "type": "integer", "minimum": 0 }, "maxBytes": { "type": "integer", "minimum": 1 }, "timeoutMs": { "type": "integer", "minimum": 1 }, "maxAttempts": { "type": "integer", "minimum": 1 }, "retryBackoffMs": { "type": "integer", "minimum": 0 }
      }
    },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "state", "availability", "finalUrl", "redirects", "dns", "contentType", "byteCount", "responseSha256", "observationIdentity", "drift", "observedAt", "facts", "attempts", "reason"],
        "properties": {
          "target": { "type": "string" }, "state": { "enum": ["PASS", "FAIL"] }, "availability": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
          "finalUrl": { "type": ["string", "null"] }, "redirects": { "type": "array", "items": { "type": "string" } },
          "dns": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["hostname", "addresses", "selectedAddress", "connectedAddress"], "properties": { "hostname": { "type": "string" }, "addresses": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "selectedAddress": { "type": "string" }, "connectedAddress": { "type": "string" } } } }, "contentType": { "type": ["string", "null"] }, "byteCount": { "type": "integer", "minimum": 0 },
          "responseSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "observationIdentity": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "drift": { "enum": ["BASELINE", "UNCHANGED", "CHANGED", "NOT_OBSERVED"] },
          "observedAt": { "type": "string", "format": "date-time" }, "facts": { "type": "array", "items": { "type": "string" } }, "attempts": { "type": "integer", "minimum": 0 }, "reason": { "type": ["string", "null"] }
        }
      }
    },
    "promotionBlockedReason": { "type": ["string", "null"] },
    "git": { "type": "object", "additionalProperties": false, "required": ["sha", "ref"], "properties": { "sha": { "type": "string" }, "ref": { "type": "string" } } }
  }
}
