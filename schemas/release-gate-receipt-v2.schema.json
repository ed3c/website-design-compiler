{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/release-gate-receipt-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overall", "git", "workflow", "environment", "bindings", "gates", "evidence", "evidenceBindings", "optionalEvidence", "unresolvedRisks"],
  "properties": {
    "schema": { "const": "website-design-compiler/release-gate-receipt/v2" },
    "overall": { "enum": ["PASS", "FAIL"] },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "ref", "event", "changedFiles"],
      "properties": {
        "sha": { "type": "string" },
        "ref": { "type": "string" },
        "event": { "type": "string" },
        "changedFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "workflow": { "type": "object" },
    "environment": { "type": "object" },
    "bindings": { "oneOf": [{ "const": "ABSENT" }, { "type": "object" }] },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "enum": ["PASS", "FAIL", "ABSENT", "NOT_IMPLEMENTED", "NOT_EXERCISED", "SKIPPED_BY_POLICY"] }
    },
    "evidence": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "evidenceBindings": { "type": "object", "minProperties": 1 },
    "optionalEvidence": { "type": "object", "minProperties": 1 },
    "unresolvedRisks": { "type": "array", "items": { "type": "object" } }
  }
}
