{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/observed-visual-fingerprint/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "producer", "referenceValueSha256", "capturedArtifactSha256", "evidenceArtifact", "dimensions", "observations"],
  "properties": {
    "schema": { "const": "website-design-compiler/observed-visual-fingerprint/v2" },
    "state": { "const": "PASS" },
    "producer": { "const": "playwright-computed-style/v1" },
    "referenceValueSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capturedArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.png$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "observations": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typography", "typeContrast", "density", "grid", "surface", "colorStrategy", "mediaStrategy", "motionIntensity", "signatureInteraction"],
      "properties": {
        "typography": { "enum": ["neo-grotesk", "editorial-serif", "humanist-sans", "display-contrast"] },
        "typeContrast": { "enum": ["restrained", "balanced", "dramatic"] },
        "density": { "enum": ["airy", "balanced", "dense"] },
        "grid": { "enum": ["strict", "asymmetric", "modular", "editorial"] },
        "surface": { "enum": ["flat", "layered", "bordered", "tonal"] },
        "colorStrategy": { "enum": ["neutral-accent", "warm-editorial", "high-contrast", "tonal-brand"] },
        "mediaStrategy": { "enum": ["text-first", "product-media", "editorial-media", "interactive-stage"] },
        "motionIntensity": { "enum": ["minimal", "moderate", "expressive"] },
        "signatureInteraction": { "enum": ["none", "progressive-reveal", "spatial-focus", "direct-manipulation"] }
      }
    }
  }
}
