{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/website-design-compiler/storybook-golden-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "promotion", "source", "screenshots"],
  "properties": {
    "schema": { "const": "website-design-compiler/storybook-golden-candidate/v1" },
    "state": { "const": "NOT_EXERCISED" },
    "promotion": { "const": "HUMAN_REVIEW_REQUIRED" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git", "workflow", "screenshotArtifact", "runnerImage", "browser", "fonts", "projects", "qualification"],
      "properties": {
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha", "ref"],
          "properties": {
            "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "runtimeGit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha", "ref"],
          "properties": {
            "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "name", "runId", "runAttempt"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
            "name": { "type": "string", "minLength": 1 },
            "runId": { "type": "integer", "minimum": 1 },
            "runAttempt": { "type": "integer", "minimum": 1 }
          }
        },
        "screenshotArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "name": { "type": "string", "pattern": "^storybook-golden-screenshots-[a-f0-9]{40}-[1-9][0-9]*$" }
          }
        },
        "runnerImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "version", "release"],
          "properties": {
            "os": { "const": "ubuntu-24.04" },
            "version": { "type": "string", "minLength": 1 },
            "release": { "type": "string", "pattern": "^ubuntu24/.+$" }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "distribution", "version", "playwrightPackage", "playwrightChromiumRevision"],
          "properties": {
            "engine": { "const": "chromium" },
            "distribution": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "playwrightPackage": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "playwrightChromiumRevision": { "type": "integer", "minimum": 1 }
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "version"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "projects": {
          "type": "array",
          "prefixItems": [
            { "const": "storybook-desktop" },
            { "const": "storybook-mobile" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storybookBuild", "browserProjects", "storybookBuildExitCode", "storybookQaExitCode", "playwrightReport", "staticBuild"],
          "properties": {
            "storybookBuild": { "const": "PASS" },
            "browserProjects": { "const": "PASS" },
            "storybookBuildExitCode": { "const": 0 },
            "storybookQaExitCode": { "const": 0 },
            "playwrightReport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "const": "artifacts/storybook/playwright-report.json" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            },
            "staticBuild": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "const": "artifacts/storybook/static/index.html" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    },
    "screenshots": {
      "type": "object",
      "minProperties": 90,
      "maxProperties": 90,
      "propertyNames": { "pattern": "^storybook-(desktop|mobile)--[^/]+\\.png$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
