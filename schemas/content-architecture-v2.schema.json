{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/content-architecture/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "audience", "objective", "sections", "forbiddenInventions", "overall"],
  "properties": {
    "schema": { "const": "website-design-compiler/content-architecture/v2" },
    "project": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "overall": { "enum": ["READY", "NEEDS_INPUT"] },
    "forbiddenInventions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionId", "sectionType", "messageGoal", "audienceQuestion", "ctaRole", "fallback", "localePolicy", "fields", "quality"],
        "properties": {
          "sectionId": { "type": "string", "minLength": 1 },
          "sectionType": { "type": "string", "minLength": 1 },
          "messageGoal": { "type": "string", "minLength": 1 },
          "audienceQuestion": { "type": "string", "minLength": 1 },
          "ctaRole": { "enum": ["PRIMARY", "SECONDARY", "NONE"] },
          "fallback": { "type": "string", "minLength": 1 },
          "localePolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceLocale", "localizationReady"],
            "properties": {
              "sourceLocale": { "const": "en" },
              "localizationReady": { "const": true }
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot", "state", "sourceType", "value", "publishable", "provenance", "lengthBudget"],
              "properties": {
                "slot": { "type": "string", "minLength": 1 },
                "state": { "enum": ["READY", "NEEDS_INPUT", "FORBIDDEN"] },
                "sourceType": { "enum": ["observed_fact", "user_supplied_claim", "derived_copy", "placeholder_required", "forbidden_invention"] },
                "value": { "type": ["string", "null"] },
                "publishable": { "type": "boolean" },
                "provenance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "lengthBudget": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["maxCharacters"],
                  "properties": { "maxCharacters": { "type": "integer", "minimum": 1 } }
                }
              }
            }
          },
          "quality": {
            "type": "object",
            "additionalProperties": false,
            "required": ["forbiddenPhraseHits", "repeatedPublishableValues"],
            "properties": {
              "forbiddenPhraseHits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "repeatedPublishableValues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        }
      }
    }
  }
}
