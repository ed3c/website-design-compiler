{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/technology-revocation.schema.json",
  "title": "Technology Revocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","candidateIdentitySha256","admissionIdentitySha256","observedChangeSha256","reason","revokedAt","revocationIdentitySha256"],
  "properties": {
    "schema": { "const": "website-design-compiler/technology-revocation/v1" },
    "candidateIdentitySha256": { "$ref": "#/$defs/sha256" },
    "admissionIdentitySha256": { "$ref": "#/$defs/sha256" },
    "observedChangeSha256": { "$ref": "#/$defs/sha256" },
    "reason": { "type": "string", "minLength": 1 },
    "revokedAt": { "type": "string", "format": "date-time" },
    "revocationIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
