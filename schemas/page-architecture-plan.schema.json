{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/page-architecture-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "pageType", "primaryObjective", "semanticLandmarks", "sections", "sectionIntents", "optionalEnhancements"],
  "properties": {
    "schema": { "const": "website-design-compiler/page-architecture-plan/v1" },
    "project": { "type": "string", "minLength": 1 },
    "pageType": { "type": "string", "minLength": 1 },
    "primaryObjective": { "type": "string", "minLength": 1 },
    "semanticLandmarks": { "type": "array", "prefixItems": [{ "const": "main" }], "minItems": 1, "maxItems": 1 },
    "sections": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "role", "required", "componentIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["hero", "runtime-evidence", "progressive-enhancement"] },
          "required": { "type": "boolean" },
          "componentIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "sectionIntents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "purpose", "priority", "status", "evidence", "requiredContent", "missingContent", "fallback", "contentContract"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["PRIMARY", "SECONDARY", "SUPPORTING"] },
          "status": { "enum": ["READY", "NEEDS_INPUT"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requiredContent": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "missingContent": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "fallback": { "type": "string", "minLength": 1 },
          "contentContract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "sectionId", "sectionType", "messageGoal", "audienceQuestion", "ctaRole", "fallback", "localePolicy", "fields", "quality"],
            "properties": {
              "state": { "enum": ["READY", "NEEDS_INPUT"] },
              "sectionId": { "type": "string", "minLength": 1 },
              "sectionType": { "type": "string", "minLength": 1 },
              "messageGoal": { "type": "string", "minLength": 1 },
              "audienceQuestion": { "type": "string", "minLength": 1 },
              "ctaRole": { "enum": ["PRIMARY", "SECONDARY", "NONE"] },
              "fallback": { "type": "string", "minLength": 1 },
              "localePolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceLocale", "localizationReady"],
                "properties": {
                  "sourceLocale": { "const": "en" },
                  "localizationReady": { "const": true }
                }
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["slot", "state", "sourceType", "value", "publishable", "provenance", "lengthBudget"],
                  "properties": {
                    "slot": { "type": "string", "minLength": 1 },
                    "state": { "enum": ["READY", "NEEDS_INPUT", "FORBIDDEN"] },
                    "sourceType": { "enum": ["observed_fact", "user_supplied_claim", "derived_copy", "placeholder_required", "forbidden_invention"] },
                    "value": {},
                    "publishable": { "type": "boolean" },
                    "provenance": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "lengthBudget": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["maxCharacters"],
                      "properties": { "maxCharacters": { "type": "integer", "minimum": 1 } }
                    }
                  },
                  "allOf": [{ "if": { "properties": { "slot": { "enum": ["feature-items", "proof-items", "related-items", "story-beats"] } }, "required": ["slot"] }, "then": { "properties": { "value": { "oneOf": [{ "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1 } }, { "type": "null" }] } } }, "else": { "properties": { "value": { "type": ["string", "null"] } } } }]
                }
              },
              "quality": {
                "type": "object",
                "additionalProperties": false,
                "required": ["forbiddenPhraseHits", "repeatedPublishableValues"],
                "properties": {
                  "forbiddenPhraseHits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "repeatedPublishableValues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                }
              }
            }
          }
        }
      }
    },
    "optionalEnhancements": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["capability", "blocksPrimaryAction", "fallbackRequired"],
        "properties": {
          "capability": { "enum": ["motion", "graphics-2d", "graphics-3d"] },
          "blocksPrimaryAction": { "const": false },
          "fallbackRequired": { "const": true }
        }
      }
    }
  }
}
