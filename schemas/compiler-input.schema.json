{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/compiler-input.schema.json",
  "title": "Website Design Compiler Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "brief", "requestedStages"],
  "properties": {
    "schema": { "const": "website-design-compiler/input/v1" },
    "project": { "type": "string", "minLength": 1 },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageType", "audience", "objective"],
      "properties": {
        "pageType": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 }
      }
    },
    "hardConstraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "authoredContent": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/authoredContentEntry" }
    },
    "briefSourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSha256", "fields"],
      "properties": {
        "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pageType", "audience", "objective"],
          "properties": {
            "pageType": { "$ref": "#/$defs/sourceField" },
            "audience": { "$ref": "#/$defs/sourceField" },
            "objective": { "$ref": "#/$defs/sourceField" }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["url", "image", "video", "html"] },
          "value": { "type": "string", "minLength": 1 },
          "visualEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["receiptPath", "receiptSha256"],
            "properties": {
              "receiptPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" },
              "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      },
      "default": []
    },
    "artDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {"type":"array","items":{"enum":["anthropic-frontend-design","google-stitch","taste-skill","repo-native"]}},
        "reviewers": {"type":"array","uniqueItems":true,"items":{"enum":["anthropic-frontend-design","google-stitch","taste-skill","repo-native"]}}
      }
    },
    "requestedStages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "authoredContentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri"],
          "properties": {
            "kind": { "enum": ["user-supplied", "benchmark-fixture"] },
            "uri": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source", "sourceSha256", "excerpt", "sha256"],
          "properties": {
            "kind": { "const": "source-excerpt" },
            "source": { "type": "string", "minLength": 1 },
            "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "excerpt": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "visualDirectionDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typography", "typeContrast", "density", "grid", "surface", "colorStrategy", "mediaStrategy", "motionIntensity", "signatureInteraction"],
      "properties": {
        "typography": { "enum": ["neo-grotesk", "editorial-serif", "humanist-sans", "display-contrast"] },
        "typeContrast": { "enum": ["restrained", "balanced", "dramatic"] },
        "density": { "enum": ["airy", "balanced", "dense"] },
        "grid": { "enum": ["strict", "asymmetric", "modular", "editorial"] },
        "surface": { "enum": ["flat", "layered", "bordered", "tonal"] },
        "colorStrategy": { "enum": ["neutral-accent", "warm-editorial", "high-contrast", "tonal-brand"] },
        "mediaStrategy": { "enum": ["text-first", "product-media", "editorial-media", "interactive-stage"] },
        "motionIntensity": { "enum": ["minimal", "moderate", "expressive"] },
        "signatureInteraction": { "enum": ["none", "progressive-reveal", "spatial-focus", "direct-manipulation"] }
      }
    },
    "sourceField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sourceExcerpt"],
      "properties": {
        "state": { "enum": ["EXPLICIT", "INFERRED"] },
        "sourceExcerpt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
