{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/source-manifest.schema.json",
  "title": "Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceId",
    "sourceClass",
    "locator",
    "accessClassification",
    "publicationClassification",
    "parser",
    "extractionPolicySha256",
    "capturedAt",
    "subject",
    "sourceIdentitySha256",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "website-design-compiler/source-manifest/v1" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "sourceClass": {
      "enum": ["ARTICLE", "PDF", "URL", "GIT_REPOSITORY", "PACKAGE", "MODEL", "PROVIDER", "ASSET", "OTHER"]
    },
    "locator": { "type": "string", "minLength": 1 },
    "accessClassification": { "enum": ["PUBLIC", "PRIVATE", "USER_PROVIDED", "PROTECTED"] },
    "publicationClassification": { "enum": ["PUBLIC_BYTES", "DIGEST_ONLY", "PRIVATE_FIXTURE", "PROHIBITED"] },
    "parser": { "$ref": "#/$defs/parserIdentity" },
    "extractionPolicySha256": { "$ref": "#/$defs/sha256" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "subject": {
      "oneOf": [
        { "$ref": "#/$defs/byteSubject" },
        { "$ref": "#/$defs/urlCaptureSubject" },
        { "$ref": "#/$defs/gitSubject" }
      ]
    },
    "sourceIdentitySha256": { "$ref": "#/$defs/sha256" },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sourceClass": { "const": "URL" } }, "required": ["sourceClass"] },
      "then": { "properties": { "subject": { "$ref": "#/$defs/urlCaptureSubject" } } }
    },
    {
      "if": { "properties": { "sourceClass": { "const": "GIT_REPOSITORY" } }, "required": ["sourceClass"] },
      "then": { "properties": { "subject": { "$ref": "#/$defs/gitSubject" } } }
    },
    {
      "if": {
        "properties": {
          "sourceClass": { "enum": ["ARTICLE", "PDF", "PACKAGE", "MODEL", "PROVIDER", "ASSET", "OTHER"] }
        },
        "required": ["sourceClass"]
      },
      "then": { "properties": { "subject": { "$ref": "#/$defs/byteSubject" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "parserIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "byteSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mediaType", "byteLength", "contentSha256"],
      "properties": {
        "kind": { "const": "BYTES" },
        "mediaType": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fromUrl", "toUrl"],
      "properties": {
        "status": { "type": "integer", "minimum": 300, "maximum": 399 },
        "fromUrl": { "type": "string", "format": "uri" },
        "toUrl": { "type": "string", "format": "uri" }
      }
    },
    "urlCaptureSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mediaType", "byteLength", "contentSha256", "requestedUrl", "finalUrl", "redirectChain"],
      "properties": {
        "kind": { "const": "URL_CAPTURE" },
        "mediaType": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "requestedUrl": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "redirectChain": {
          "type": "array",
          "items": { "$ref": "#/$defs/redirect" }
        }
      }
    },
    "gitSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "commit", "tree", "paths"],
      "properties": {
        "kind": { "const": "GIT" },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
