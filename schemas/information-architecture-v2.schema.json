{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-design-compiler/information-architecture/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "family", "primaryIntent", "navigation", "sections", "forbiddenInventions"],
  "properties": {
    "schema": { "const": "website-design-compiler/information-architecture/v2" },
    "project": { "type": "string", "minLength": 1 },
    "family": { "enum": ["b2b-product", "editorial", "premium-consumer", "motion-heavy-creative", "interactive-2d", "interactive-3d"] },
    "primaryIntent": { "type": "string", "minLength": 1 },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "mobilePriority"],
      "properties": {
        "mode": { "enum": ["single-page", "content-led", "multi-route-ready"] },
        "mobilePriority": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "purpose", "priority", "evidence", "requiredContent", "missingContent", "fallback", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["PRIMARY", "SECONDARY", "SUPPORTING"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requiredContent": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "missingContent": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "fallback": { "type": "string", "minLength": 1 },
          "status": { "enum": ["READY", "NEEDS_INPUT"] }
        }
      }
    },
    "forbiddenInventions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
