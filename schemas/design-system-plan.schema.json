{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/design-system-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "sourceContract", "identityPolicy", "arbitraryComponentAdmission", "selectedVisualDirection", "tokenRoles", "governedComponents", "requiredStateOwnership"],
  "properties": {
    "schema": { "const": "website-design-compiler/design-system-plan/v1" },
    "project": { "type": "string", "minLength": 1 },
    "sourceContract": { "const": "website-design-compiler/design-contract-bundle/v1" },
    "identityPolicy": { "const": "ORIGINAL_VALUES_ONLY" },
    "arbitraryComponentAdmission": { "const": false },
    "selectedVisualDirection": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "searchSeed", "candidateId", "dimensions"],
      "properties": {
        "source": { "const": "website-design-compiler/visual-direction-search/v2" },
        "searchSeed": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["typography", "typeContrast", "density", "grid", "surface", "colorStrategy", "mediaStrategy", "motionIntensity", "signatureInteraction"],
          "properties": {
            "typography": { "enum": ["neo-grotesk", "editorial-serif", "humanist-sans", "display-contrast"] },
            "typeContrast": { "enum": ["restrained", "balanced", "dramatic"] },
            "density": { "enum": ["airy", "balanced", "dense"] },
            "grid": { "enum": ["strict", "asymmetric", "modular", "editorial"] },
            "surface": { "enum": ["flat", "layered", "bordered", "tonal"] },
            "colorStrategy": { "enum": ["neutral-accent", "warm-editorial", "high-contrast", "tonal-brand"] },
            "mediaStrategy": { "enum": ["text-first", "product-media", "editorial-media", "interactive-stage"] },
            "motionIntensity": { "enum": ["minimal", "moderate", "expressive"] },
            "signatureInteraction": { "enum": ["none", "progressive-reveal", "spatial-focus", "direct-manipulation"] }
          }
        }
      }
    },
    "tokenRoles": {
      "type": "object", "additionalProperties": false,
      "required": ["color", "type", "spacing", "radii", "motion"],
      "properties": {
        "color": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "type": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "spacing": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "radii": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "motion": { "type": "object", "additionalProperties": false, "required": ["fastMs", "baseMs", "slowMs"], "properties": { "fastMs": { "type": "integer", "minimum": 0 }, "baseMs": { "type": "integer", "minimum": 0 }, "slowMs": { "type": "integer", "minimum": 0 } } }
      }
    },
    "governedComponents": { "type": "array", "minItems": 1, "items": { "enum": ["button", "status-panel"] }, "uniqueItems": true },
    "requiredStateOwnership": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["component", "states"],
        "properties": { "component": { "enum": ["button", "status-panel"] }, "states": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true } }
      }
    }
  }
}
