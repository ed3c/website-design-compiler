{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/issue-35-puck-runtime.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overall", "git", "runtime", "graphs", "controls", "commands"],
  "properties": {
    "schema": { "const": "website-design-compiler/issue-35-puck-runtime/v1" },
    "overall": { "enum": ["PASS", "FAIL", "NOT_EXERCISED"] },
    "git": { "$ref": "#/$defs/git" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer", "graphSource", "package", "version"],
      "properties": {
        "consumer": { "const": "apps/site/components/studio/studio-editor.tsx" },
        "graphSource": { "const": "apps/site/generated/benchmark-page-graphs.json" },
        "package": { "const": "@puckeditor/core" },
        "version": { "const": "0.22.4" }
      }
    },
    "graphs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "fingerprint", "nodeCount", "publishedFingerprint", "renderedSemanticOrder", "semanticOrder"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "fingerprint": { "$ref": "#/$defs/sha256" },
          "nodeCount": { "type": "integer", "minimum": 5 },
          "publishedFingerprint": { "$ref": "#/$defs/sha256" },
          "renderedSemanticOrder": { "$ref": "#/$defs/semanticOrder" },
          "semanticOrder": { "$ref": "#/$defs/semanticOrder" }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraPropertyRejected", "manualBenchmarkGraphRequired", "unknownBlockRejected"],
      "properties": {
        "extraPropertyRejected": { "const": true },
        "manualBenchmarkGraphRequired": { "const": false },
        "unknownBlockRejected": { "const": true }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "verdict"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "verdict": { "const": "PASS" }
        }
      }
    }
  },
  "$defs": {
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha", "tree"],
      "properties": {
        "ref": { "type": "string", "pattern": "^refs/heads/.+" },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "semanticOrder": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
