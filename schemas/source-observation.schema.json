{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/source-observation.schema.json",
  "title": "Source Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claimClass",
    "observationId",
    "sourceIdentitySha256",
    "statement",
    "anchors",
    "evidenceSha256",
    "parser",
    "observationIdentitySha256",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "website-design-compiler/source-observation/v1" },
    "claimClass": { "const": "OBSERVATION" },
    "observationId": { "type": "string", "pattern": "^obs-[a-f0-9]{20}$" },
    "sourceIdentitySha256": { "$ref": "#/$defs/sha256" },
    "statement": { "type": "string", "minLength": 1 },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/pageAnchor" },
          { "$ref": "#/$defs/lineAnchor" },
          { "$ref": "#/$defs/gitPathAnchor" },
          { "$ref": "#/$defs/sectionAnchor" }
        ]
      }
    },
    "evidenceSha256": { "$ref": "#/$defs/sha256" },
    "parser": { "$ref": "#/$defs/parserIdentity" },
    "observationIdentitySha256": { "$ref": "#/$defs/sha256" },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parserIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pageAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page"],
      "properties": {
        "kind": { "const": "PAGE" },
        "page": { "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "startLine": ["endLine"],
        "endLine": ["startLine"]
      }
    },
    "lineAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "startLine", "endLine"],
      "properties": {
        "kind": { "const": "LINES" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "gitPathAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "const": "GIT_PATH" },
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "startLine": ["endLine"],
        "endLine": ["startLine"]
      }
    },
    "sectionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "heading"],
      "properties": {
        "kind": { "const": "SECTION" },
        "heading": { "type": "string", "minLength": 1 }
      }
    }
  }
}
