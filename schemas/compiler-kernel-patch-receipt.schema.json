{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/website-design-compiler/schemas/compiler-kernel-patch-receipt.schema.json",
  "title": "Compiler Kernel Patch Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "patchReceiptIdentitySha256",
    "beforeConstraintReportIdentitySha256",
    "afterConstraintReportIdentitySha256",
    "introducedHardFailures",
    "resultDigest",
    "receiptIdentitySha256"
  ],
  "properties": {
    "schema": { "const": "website-design-compiler/compiler-kernel-patch-receipt/v1" },
    "state": { "enum": ["APPLIED", "CONFLICT", "REJECTED", "HARD_CONSTRAINT_REJECTED"] },
    "patchReceiptIdentitySha256": { "$ref": "#/$defs/sha256" },
    "beforeConstraintReportIdentitySha256": { "$ref": "#/$defs/sha256" },
    "afterConstraintReportIdentitySha256": { "$ref": "#/$defs/nullableSha256" },
    "introducedHardFailures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" }
    },
    "resultDigest": { "$ref": "#/$defs/nullableSha256" },
    "receiptIdentitySha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": { "oneOf": [ { "$ref": "#/$defs/sha256" }, { "type": "null" } ] }
  }
}
